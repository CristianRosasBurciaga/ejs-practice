<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Friends List</title>
</head>
<body>
    <%- include('partials/header') %>
    <h2>Your friends:</h2>
    <ul>
        <% friends.forEach(friend=> { %>
            <li><%= friend %></li>
        <% }) %>
    </ul>
    <%- include('partials/footer') %>
</body>
</html>